# ── API Keys ──────────────────────────────────────────────────────────────────
# Groq — used for Whisper transcription (free, fast)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# OpenRouter — used for DeepSeek meeting notes generation
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# ── Voice Memos Folder (optional) ────────────────────────────────────────────
# Default: ./voice_memos (relative to app.py)
# Or point directly at Apple Voice Memos:
# VOICE_MEMOS_DIR=~/Library/Group Containers/group.com.apple.VoiceMemos.shared/Recordings
# VOICE_MEMOS_DIR=./voice_memos
